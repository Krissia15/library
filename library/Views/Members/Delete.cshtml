@model Member
@{
    ViewData["Title"] = "Delete member";
}

<h1 class="mb-3">Delete member</h1>

<h3>Are you sure you want to delete this member?</h3>

<div class="card card-body" style="max-width:36rem">
    <dl class="row">
        <dt class="col-sm-4">Full Name</dt>
        <dd class="col-sm-8">@Model.FullName</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

        <dt class="col-sm-4">Member Type</dt>
        <dd class="col-sm-8">@Model.MemberType</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MemberId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>