@model List<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<h1 class="mb-3">Members</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add a member</a>
<p class="text-muted">@Model.Count members in the catalogue</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Member Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.MemberId</td>
                    <td>@member.FullName</td>
                    <td>@(member.Email ?? "—")</td>
                    <td>
                        <span class="badge text-bg-secondary">
                            @member.MemberType
                        </span>
                    </td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@member.MemberId"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                            <a asp-action="Delete"
                               asp-route-id="@member.MemberId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>

                </tr>
            }
        </tbody>
    </table>
</div>
