@model MemberDetails

@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="p-4 mb-4 rounded-4" style="background: linear-gradient(135deg, #e8f1ff, #f5f8ff);">
    <p class="text-primary fw-semibold mb-1">MEMBER PROFILE</p>
    <h1 class="fw-bold mb-1">@Model.Member.FullName</h1>
    <p class="text-muted mb-0">
        @Model.Member.MemberType · @(Model.Member.Email ?? "no email")
    </p>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 fw-bold mb-0">Loan History</h2>
            <span class="badge rounded-pill text-bg-primary">
                @Model.Loans.Count loans
            </span>
        </div>

        @if (Model.Loans.Count == 0)
        {
            <div class="text-center py-4">
                <h3 class="h6 fw-bold">No loan records yet</h3>
                <p class="text-muted mb-0">This member has never borrowed a book.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Book</th>
                            <th>Loaned</th>
                            <th>Returned</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Loans)
                        {
                            <tr>
                                <td class="fw-semibold">@loan.BookTitle</td>
                                <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                                <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>
                                    @if (loan.Status == "Overdue")
                                    {
                                        <span class="badge rounded-pill text-bg-danger">Overdue</span>
                                    }
                                    else if (loan.Status == "Out")
                                    {
                                        <span class="badge rounded-pill text-bg-warning">Out</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-success">Returned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary rounded-pill mt-3">
    ← Back to members
</a>
