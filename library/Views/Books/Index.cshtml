
@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="p-4 mb-4 rounded-4 shadow-sm"
     style="background: linear-gradient(135deg, #f9dce8, #fff0f5);">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="fw-semibold mb-1"
               style="color: #c95f88; letter-spacing: 2px;">
                🎀 YOUR LITTLE BOOK COLLECTION
            </p>

            <h1 class="fw-bold mb-2">Bookshelf ♡</h1>

            <p class="mb-0 text-muted">
                @Model.Count books waiting to be explored.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            + Add a book ♡
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h5 fw-bold mb-1">📚 Book Collection</h2>
                <p class="text-muted small mb-0">
                    All your lovely books in one place.
                </p>
            </div>

            <span class="badge rounded-pill px-3 py-2"
                  style="background-color: #f4c5d7; color: #87445f;">
                @Model.Count Books
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th class="text-end" style="width: 4rem">#</th>
                        <th>Book Title</th>
                        <th>Category</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td class="text-end">@book.BookId</td>

                            <td class="fw-semibold">
                                📖 @book.Title
                            </td>

                            <td>
                                <span class="badge text-bg-secondary">
                                    @(book.Category ?? "—")
                                </span>
                            </td>

                            <td class="text-end fw-semibold">
                                @(book.Price?.ToString("N2") ?? "—")
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@book.BookId"
                                       class="btn btn-sm btn-outline-primary">
                                        ✏️ Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@book.BookId"
                                       class="btn btn-sm btn-outline-danger">
                                        ♡ Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <div style="font-size: 45px;">📚</div>
                <h3 class="h5 fw-bold mt-3">Your bookshelf is waiting!</h3>
                <p class="text-muted mb-0">
                    Add your first book to get started. ♡
                </p>
            </div>
        }

    </div>
</div>

<div class="text-center mt-4 p-3 rounded-4"
     style="background-color: #fce4ed;">
    <p class="mb-0 fw-semibold" style="color: #c95f88;">
        Every book is a new adventure. 🌷
    </p>
</div>
