@model IEnumerable<library.Models.Note>

@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Library Notes</h1>
        <p class="text-muted">Keep track of library reminders and tasks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add a Note</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No notes yet. Click "Add a Note" to create one.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Body</th>
                    <th>Created On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var note in Model)
                {
                    <tr>
                        <td>@note.Title</td>
                        <td>@(string.IsNullOrWhiteSpace(note.Body) ? "—" : note.Body)</td>
                        <td>@note.CreatedOn.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@note.NoteId"
                               class="btn btn-sm btn-outline-primary">Edit</a>

                            <a asp-action="Delete"
                               asp-route-id="@note.NoteId"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
