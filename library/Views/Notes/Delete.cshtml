
@model library.Models.Note

@{
    ViewData["Title"] = "Delete Note";
}

<h1>Delete Note</h1>

<h4>Are you sure you want to delete this note?</h4>

<div class="card p-3 mb-3">
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Body</dt>
        <dd class="col-sm-10">@(Model.Body ?? "—")</dd>

        <dt class="col-sm-2">Created On</dt>
        <dd class="col-sm-10">@Model.CreatedOn.ToString("yyyy-MM-dd")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="NoteId" />

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
