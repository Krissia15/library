@model BorrowForm

@{
    ViewData["Title"] = "Borrow a book";
}

<div class="p-4 mb-4 rounded-4" style="background: linear-gradient(135deg, #e8f1ff, #f5f8ff);">
    <p class="text-primary fw-semibold mb-1">LIBRARY MANAGEMENT</p>
    <h1 class="fw-bold mb-1">Borrow a book</h1>
    <p class="text-muted mb-0">Select a member and a book to create a loan record.</p>
</div>

<div class="card border-0 shadow-sm rounded-4" style="max-width: 36rem;">
    <div class="card-body p-4">
        <h2 class="h5 fw-bold mb-4">Loan Information</h2>

        <form asp-action="Borrow" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="MemberId" class="form-label fw-semibold">Member</label>
                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                    <option value="">(choose a member)</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BookId" class="form-label fw-semibold">Book</label>
                <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                    <option value="">(choose a book)</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DaysAllowed" class="form-label fw-semibold">Days allowed</label>
                <input asp-for="DaysAllowed" class="form-control" />
                <span asp-validation-for="DaysAllowed" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    Borrow book
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
