
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center p-5 mb-4 rounded-4 shadow-sm"
     style="background: linear-gradient(135deg, #f9dce8, #fff0f5);">

    <div style="font-size: 45px;">🎀 📚 🎀</div>

    <p class="text-uppercase fw-semibold mb-2"
       style="color: #c95f88; letter-spacing: 3px;">
        YOUR LITTLE BOOK PARADISE
    </p>

    <h1 class="display-4 fw-bold mb-3" style="color: #c95f88;">
        Welcome to Pink Library!
    </h1>

    <p class="fs-5 mb-3" style="color: #805568;">
        A cozy little place where every book has a story. ♡
    </p>

    <span class="badge rounded-pill px-3 py-2"
          style="background-color: #e88eae; color: white;">
        Made with love for book lovers
    </span>
</div>

<div class="text-center mb-4">
    <h2 class="fw-bold">Explore Your Library ♡</h2>
    <p class="text-muted">Choose where you want to go!</p>
</div>

<div class="row g-4 mb-5">

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 text-center p-4 shadow-sm">
            <div style="font-size: 42px;">📚</div>
            <h3 class="h5 fw-bold mt-3">Books</h3>
            <p class="text-muted">Browse and manage your book collection.</p>
            <a asp-controller="Books" asp-action="Index"
               class="btn btn-primary mt-auto">Explore Books ♡</a>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 text-center p-4 shadow-sm">
            <div style="font-size: 42px;">🌷</div>
            <h3 class="h5 fw-bold mt-3">Members</h3>
            <p class="text-muted">View and manage library members.</p>
            <a asp-controller="Members" asp-action="Index"
               class="btn btn-primary mt-auto">View Members ♡</a>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 text-center p-4 shadow-sm">
            <div style="font-size: 42px;">💌</div>
            <h3 class="h5 fw-bold mt-3">Loans</h3>
            <p class="text-muted">Keep track of borrowed books and returns.</p>
            <a asp-controller="Loans" asp-action="Index"
               class="btn btn-primary mt-auto">View Loans ♡</a>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 text-center p-4 shadow-sm">
            <div style="font-size: 42px;">📝</div>
            <h3 class="h5 fw-bold mt-3">Notes</h3>
            <p class="text-muted">Visit your library notes section.</p>
            <a asp-controller="Notes" asp-action="Index"
               class="btn btn-primary mt-auto">View Notes ♡</a>
        </div>
    </div>

</div>

<div class="text-center p-4 rounded-4 mb-4"
     style="background-color: #fce4ed;">
    <h3 class="h5 fw-bold" style="color: #c95f88;">
        "A room without books is like a garden without flowers." 🌸
    </h3>
    <p class="mb-0" style="color: #805568;">
        Happy reading! ♡
    </p>
</div>
